{
  "name": "dsh-close-all-pages",
  "version": "0.1.0",
  "description": "One-click control that closes every page open in the right sidebar.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neeanee/dsh-close-all-pages.git"
  },
  "homepage": "https://github.com/neeanee/dsh-close-all-pages#readme",
  "bugs": {
    "url": "https://github.com/neeanee/dsh-close-all-pages/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "tabs"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
